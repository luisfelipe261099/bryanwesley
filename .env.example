# ── Banco de dados (obrigatório) ──────────────────────────────
# TiDB Cloud (compatível com MySQL). Copie da tela "Connect" do cluster.
# TLS fica ligado sozinho para hosts remotos.
DATABASE_URL=mysql://usuario:senha@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/bryanwesley
# Só para MySQL/MariaDB local sem TLS:
# DATABASE_SSL=false

# ── Sessão (obrigatório) ──────────────────────────────────────
# Chave usada para assinar o cookie de login. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres

# ── Senha inicial do seed (opcional) ──────────────────────────
# Usada só na primeira carga, para as contas da equipe.
SEED_PASSWORD=bryan2026

# ── URL pública (opcional) ────────────────────────────────────
# Entra no QR de check-in. Na Vercel é detectada sozinha.
NEXT_PUBLIC_SITE_URL=https://bryanwesley.vercel.app

# ── Notificações no WhatsApp (opcional) ───────────────────────
# Sem estas variáveis o sistema funciona normalmente: as mensagens
# ficam gravadas na fila, apenas não são entregues.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Cron (OBRIGATÓRIO em produção) ────────────────────────────
# Protege o endpoint que despacha notificações, materializa horários
# fixos e expira assinaturas. Sem ele, em produção, o endpoint responde
# 503 e não dispara nada. Gere como o AUTH_SECRET.
CRON_SECRET=

# ── InfinitePay (opcional) ────────────────────────────────────
# Handle é o seu InfiniteTag sem o "$". Só cobrança avulsa:
# a API não tem assinatura recorrente nativa.
INFINITEPAY_HANDLE=

# ── URL pública para QR e webhooks ────────────────────────────
# Já detectada na Vercel; defina só se usar domínio próprio.
# NEXT_PUBLIC_SITE_URL=https://bryanwesley.com.br
