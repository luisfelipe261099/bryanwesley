# ── Banco de dados (obrigatório) ──────────────────────────────
# TiDB Cloud (compatível com MySQL). Copie da tela "Connect" do cluster.
# TLS fica ligado sozinho para hosts remotos.
DATABASE_URL=mysql://usuario:senha@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/bryanwesley
# Só para MySQL/MariaDB local sem TLS:
# DATABASE_SSL=false

# ── Sessão (obrigatório) ──────────────────────────────────────
# Chave usada para assinar o cookie de login. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres

# ── Senha inicial do seed (opcional) ──────────────────────────
# Usada só na primeira carga, para as contas da equipe.
SEED_PASSWORD=bryan2026

# ── URL pública (opcional) ────────────────────────────────────
# Entra no QR de check-in. Na Vercel é detectada sozinha.
NEXT_PUBLIC_SITE_URL=https://bryanwesley.vercel.app

# ── WhatsApp (opcional) ───────────────────────────────────────
# Sem nenhum dos dois o sistema funciona normalmente: as mensagens
# ficam gravadas na fila, apenas não são entregues.
#
# Grátis — WAHA no servidor da barbearia. O jeito fácil (a "ponte") não
# precisa de NENHUMA variável: é pelo painel, Mensagens → Gerar comando de
# instalação (passo a passo em deploy/waha/LEIAME.md). As três abaixo são
# só para quem tem um WAHA com HTTPS próprio:
WAHA_URL=
WAHA_API_KEY=
# Assina o que o WAHA manda para o site. Gere: openssl rand -hex 32
WAHA_HMAC_KEY=
# WAHA_SESSION=default
# Minutos que o atendente fica quieto quando a barbearia responde pelo celular (0 desliga).
# WHATSAPP_PAUSA_HUMANO_MIN=240
#
# Oficial — Cloud API da Meta:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
#
# Com os dois configurados, escolha: waha | meta
# WHATSAPP_PROVIDER=

# ── Gemini (opcional, grátis) ─────────────────────────────────
# Faz o atendente do WhatsApp entender frases inteiras ("corte sábado
# de tarde"). Chave em aistudio.google.com. Sem ela, segue pelo menu.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TETO_DIARIO=400

# ── Cron (OBRIGATÓRIO em produção) ────────────────────────────
# Protege o endpoint que despacha notificações, materializa horários
# fixos e expira assinaturas. Sem ele, em produção, o endpoint responde
# 503 e não dispara nada. Gere como o AUTH_SECRET.
CRON_SECRET=

# ── InfinitePay (opcional) ────────────────────────────────────
# Handle é o seu InfiniteTag sem o "$". Só cobrança avulsa:
# a API não tem assinatura recorrente nativa.
INFINITEPAY_HANDLE=
