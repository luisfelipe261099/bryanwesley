# Endereço público deste servidor. O Caddy tira o certificado HTTPS sozinho.
# Sem domínio? Use o IP do servidor com traços + .sslip.io
# (ex.: servidor 203.0.113.10 → waha-203-0-113-10.sslip.io).
DOMINIO=waha-203-0-113-10.sslip.io

# A chave que o site usa para falar com o WAHA — a MESMA vai na Vercel
# como WAHA_API_KEY. Gere com:  openssl rand -hex 32
WAHA_API_KEY=troque-por-uma-chave-longa

# Acesso ao painel do próprio WAHA (https://DOMINIO/dashboard) e à
# documentação da API. Troque as senhas.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=troque-esta-senha
